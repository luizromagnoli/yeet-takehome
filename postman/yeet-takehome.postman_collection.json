              {
                "key": "X-Override-Hmac",
                "value": "HMAC-SHA256 7376e78d5f65ca750c9719d2163daffa129e8a07ba9a1abe12241b3b1de51295",
                "description": "Pins the literal hex from the PDF — the body byte sequence below matters (note the spaces after each colon)."
