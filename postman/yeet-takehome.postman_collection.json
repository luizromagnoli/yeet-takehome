    {
      "name": "RTP reports",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Default both report endpoints to the current UTC day.",
              "const day = new Date().toISOString().slice(0, 10);",
              "pm.variables.set('reportFrom', day + 'T00:00:00Z');",
              "pm.variables.set('reportTo', day + 'T23:59:59Z');"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "GET /report/users  (today)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/aggregator/takehome/report/users?from={{reportFrom}}&to={{reportTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["aggregator", "takehome", "report", "users"],
              "query": [
                { "key": "from", "value": "{{reportFrom}}" },
                { "key": "to", "value": "{{reportTo}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /report/users  (paginated, limit=2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/aggregator/takehome/report/users?from={{reportFrom}}&to={{reportTo}}&limit=2",
              "host": ["{{baseUrl}}"],
              "path": ["aggregator", "takehome", "report", "users"],
              "query": [
                { "key": "from", "value": "{{reportFrom}}" },
                { "key": "to", "value": "{{reportTo}}" },
                { "key": "limit", "value": "2" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /report/casino  (today)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/aggregator/takehome/report/casino?from={{reportFrom}}&to={{reportTo}}",
              "host": ["{{baseUrl}}"],
              "path": ["aggregator", "takehome", "report", "casino"],
              "query": [
                { "key": "from", "value": "{{reportFrom}}" },
                { "key": "to", "value": "{{reportTo}}" }
              ]
            }
          },
          "response": []
        }
      ]
    },
